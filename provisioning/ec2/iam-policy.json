{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadGhaHostParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:*:*:parameter/gha-host/*"
    },
    {
      "Sid": "DecryptParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:*:*:key/REPLACE-WITH-KEY-ID",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.*.amazonaws.com" } }
    },
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPullRunnerImage",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": "arn:aws:ecr:*:*:repository/gha-host-runner"
    }
  ]
}
