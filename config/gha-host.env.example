# Example /etc/gha-host/gha-host.env. install.sh writes this file for you; every
# value can be set by installer flag instead. Values must not contain
# double quotes, $, backticks, backslashes or newlines. See docs/configuration.md.

# --- GitHub (org-level runners) ---
GH_ORG="my-org"
GH_AUTH="auto"                         # auto | app | pat
GH_PAT_FILE="/etc/gha-host/pat"
GH_APP_ID=""
GH_APP_INSTALLATION_ID=""              # optional, looked up if empty
GH_APP_KEY_FILE="/etc/gha-host/github-app.pem"
RUNNER_GROUP="Default"

# --- Runners ---
HOST_NAME="gha-01"                     # runner names: gha-01-1 .. gha-01-N
RUNNER_COUNT="4"
RUNNER_MODE="persistent"               # persistent | ephemeral
RUNNER_LABELS="gha-host,build"         # replaces the default "gha-host"

# --- Image ---
RUNNER_IMAGE="gha-host-runner:local"
BUILD_IMAGE="true"
REGISTRY_AUTH="auto"                   # auto | ecr | basic | none

# --- Host ---
DATA_DISK=""                           # e.g. /dev/sdb or auto
DATA_DIR="/data"

# --- Cleanup ---
PRUNE_INTERVAL="hourly"
PRUNE_SOFT_PCT="75"
PRUNE_HARD_PCT="90"
